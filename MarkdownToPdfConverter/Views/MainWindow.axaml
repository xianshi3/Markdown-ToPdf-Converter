<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MarkdownToPdfConverter.ViewModels"
        xmlns:components="clr-namespace:MarkdownToPdfConverter.Views.Components"
        x:Class="MarkdownToPdfConverter.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        MinWidth="800" MinHeight="600"
        SystemDecorations="None"
        Background="{DynamicResource ThemeBackground}"
        FontFamily="Inter, Segoe UI, system-ui, sans-serif"
        KeyDown="OnKeyDown"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Styles>
        <!-- ===== Global Transitions (smooth theme switching & interactions) ===== -->
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>


        <Style Selector="Border">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.35"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.dropzone">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.dropzone:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        </Style>
        <Style Selector="Border.dragover">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTabItemForeground}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                    <ThicknessTransition Property="BorderThickness" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTabItemSelectedForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeTabSelectedBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
        <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:pointerover">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ThemeScrollBarThumb}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ScrollBar:pointerover /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ThemeScrollBarThumbHover}"/>
        </Style>

        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Menu">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
        </Style>

        <Style Selector="Slider">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Ellipse">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid x:Name="RootGrid" RowDefinitions="36,Auto,Auto,*" DragDrop.AllowDrop="True">
        <components:TitleBarComponent Grid.Row="0" />
        <components:MenuBarComponent Grid.Row="1" />
        <components:ToolBarComponent Grid.Row="2" />

        <Grid Grid.Row="3" Margin="12,12" RowDefinitions="Auto,*">
            <components:FindReplaceComponent Grid.Row="0" Margin="0,0,0,12" />

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*"
                  IsVisible="{Binding !IsPreviewVisible}">
                <components:SidebarComponent Grid.Column="0"
                                             IsVisible="{Binding IsSidebarExpanded}"
                                             Margin="0,0,10,0" />
                <Grid Grid.Column="1" RowDefinitions="*,Auto">
                    <components:EditorComponent Grid.Row="0" />
                    <components:StatusBarComponent Grid.Row="1" Margin="0,12,0,0" />
                </Grid>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*"
                  IsVisible="{Binding IsPreviewVisible}">
                <components:SidebarComponent Grid.Column="0"
                                             IsVisible="{Binding IsSidebarExpanded}"
                                             Margin="0,0,10,0" />
                <Grid Grid.Column="1" RowDefinitions="*,Auto">
                    <components:EditorComponent Grid.Row="0" />
                    <components:StatusBarComponent Grid.Row="1" Margin="0,12,0,0" />
                </Grid>
                <GridSplitter Grid.Column="2"
                              Width="5"
                              Background="{DynamicResource ThemeBorderBrush}"
                              Opacity="0.5" />
                <components:PreviewComponent Grid.Column="3" />
            </Grid>
        </Grid>
    </Grid>
</Window>
