<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MarkdownToPdfConverter.Views.ErrorDialog"
        Title="Conversion Error"
        Width="600" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{DynamicResource ThemeBackground}">
  <Window.Styles>
    <Style Selector="Border.dialog-card">
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="TextBlock.dialog-title">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style Selector="TextBox.error-text">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Background" Value="{DynamicResource ThemeAccentColor}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="AcceptsReturn" Value="True"/>
    </Style>
  </Window.Styles>

  <Border Classes="dialog-card">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
        <Button Content="{DynamicResource str_copy}" Click="OnCopyClick" Padding="16,8"/>
        <Button Content="{DynamicResource str_close}" Click="OnCloseClick" Padding="16,8"/>
      </StackPanel>
      <TextBox Classes="error-text" x:Name="ErrorTextBox" Text="{Binding ErrorMessage, RelativeSource={RelativeSource Self}}"/>
    </DockPanel>
  </Border>
</Window>
