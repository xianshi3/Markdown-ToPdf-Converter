<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MarkdownToPdfConverter.ViewModels"
             x:Class="MarkdownToPdfConverter.Views.Components.SidebarComponent"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <Style Selector="Border.sidebar-bg">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.35"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.setting-card">
            <Setter Property="Background" Value="{DynamicResource ThemeBackground}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.35"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="TextBlock.setting-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryForeground}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="ComboBox.setting-combo">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <Style Selector="Slider.setting-slider">
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
        </Style>

        <Style Selector="TextBox.setting-input">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeStatValueColor}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="MaxLength" Value="4"/>
        </Style>
        <Style Selector="TextBox.setting-input:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        </Style>

        <Style Selector="Border.card-divider">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="Opacity" Value="0.15"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style Selector="Button.sidebar-toggle">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryForeground}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.sidebar-toggle:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
        </Style>
        <Style Selector="Button.sidebar-toggle:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>

        <Style Selector="TextBlock.section-label">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryForeground}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="1.2"/>
        </Style>

        <Style Selector="Border.recent-card">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeBackground}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.35"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.3"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.recent-file-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSecondaryForeground}"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.recent-file-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeButtonHoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeStatValueColor}"/>
        </Style>
        <Style Selector="Button.recent-file-btn:first-child">
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="sidebar-bg">
        <ScrollViewer>
            <StackPanel Spacing="14">

                <!-- ===== Settings ===== -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource str_sidebar_export_options}" Classes="section-label"/>
                    <Border Classes="setting-card">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="setting-label" Text="{DynamicResource str_sidebar_page_size}"/>
                                <ComboBox Classes="setting-combo"
                                          ItemsSource="{Binding PageSizeOptions}"
                                          SelectedItem="{Binding PageSize}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Classes="setting-label" Text="{DynamicResource str_sidebar_font}"/>
                                <ComboBox Classes="setting-combo"
                                          ItemsSource="{Binding FontOptions}"
                                          SelectedItem="{Binding ExportFont}"
                                          HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <Border Classes="card-divider"/>
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="setting-label" Text="{DynamicResource str_sidebar_margin}"/>
                                    <TextBox Classes="setting-input"
                                             Text="{Binding PageMargin, StringFormat='{}{0:F0}'}"/>
                                </Grid>
                                <Slider Classes="setting-slider"
                                        Value="{Binding PageMargin}"
                                        Maximum="50"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="setting-label" Text="{DynamicResource str_sidebar_font_size}"/>
                                    <TextBox Classes="setting-input"
                                             Text="{Binding FontSize, StringFormat='{}{0:F0}'}"/>
                                </Grid>
                                <Slider Classes="setting-slider"
                                        Value="{Binding FontSize}"
                                        Minimum="12" Maximum="24"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Language / Theme ===== -->
                <Grid ColumnDefinitions="*,8,*">
                    <Button Classes="sidebar-toggle" Command="{Binding SwitchLanguageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <Path Data="M 2,4 L 10,4 M 2,8 L 8,8 M 2,12 L 6,12 M 3,2 V 14"
                                  Stroke="{DynamicResource ThemeSecondaryForeground}"
                                  StrokeThickness="1.5" Stretch="Uniform" Width="13" Height="13"/>
                            <TextBlock Text="{Binding LanguageButtonText}"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Classes="sidebar-toggle" Command="{Binding SwitchThemeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                            <Path Data="M 8,2 C 5,2 3,5 3,8 C 3,11 5,14 8,14 C 10,14 12,12 13,10 C 8,10 5,7 8,2"
                                  Stroke="{DynamicResource ThemeSecondaryForeground}"
                                  StrokeThickness="1.5" Stretch="Uniform" Width="13" Height="13"/>
                            <TextBlock Text="{Binding CurrentTheme}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ===== Recent Files ===== -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource str_sidebar_recent}" Classes="section-label"/>
                    <Border Classes="recent-card">
                        <ItemsControl ItemsSource="{Binding RecentFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="x:String">
                                    <Button Classes="recent-file-btn">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Path Data="M 2,1 L 8,1 L 12,5 L 12,15 C 12,16 11,17 10,17 L 4,17 C 3,17 2,16 2,15 Z M 8,1 L 8,5 L 12,5"
                                                  Stroke="{DynamicResource ThemeSecondaryForeground}"
                                                  StrokeThickness="1.5" Stretch="Uniform" Width="11" Height="13"/>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
