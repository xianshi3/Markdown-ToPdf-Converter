<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MarkdownToPdfConverter.ViewModels"
             x:Class="MarkdownToPdfConverter.Views.Components.FindReplaceComponent"
             x:DataType="vm:MainViewModel"
             IsVisible="{Binding IsFindVisible}">
    <Border Background="{DynamicResource ThemeSurfaceBackground}"
            CornerRadius="10"
            Padding="12">
        <Grid ColumnDefinitions="*,*,Auto,Auto">
            <TextBox Grid.Column="0"
                     Text="{Binding FindText}"
                     Watermark="{DynamicResource str_find_placeholder}"
                     Margin="0,0,8,0"/>
            <TextBox Grid.Column="1"
                     Text="{Binding ReplaceText}"
                     Watermark="{DynamicResource str_replace_placeholder}"
                     Margin="0,0,8,0"/>
            <Button Grid.Column="2"
                    Command="{Binding ReplaceCommand}"
                    Content="{DynamicResource str_find_replace}"
                    Padding="12,6"
                    Margin="0,0,8,0"/>
            <Button Grid.Column="3"
                    Command="{Binding CloseFindCommand}"
                    Content="✕"
                    Padding="8,6"
                    Background="Transparent"
                    Foreground="{DynamicResource ThemeSecondaryForeground}"/>
        </Grid>
    </Border>
</UserControl>
